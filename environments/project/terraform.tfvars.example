# Copy to local.auto.tfvars on a new checkout, then replace placeholders.
# If local.auto.tfvars.json already exists, edit that file instead.
# The monitoring import also requires monitoring_config, whose full object schema
# is defined in monitoring-variables.tf. Obtain reviewed values privately;
# do not derive desired settings dynamically from the live instance on every plan.
# The security group import additionally requires monitoring_security_group,
# defined in monitoring-security-group-variables.tf, including stable rule keys.
aws_account_id = "<AWS_ACCOUNT_ID>"
aws_region     = "ap-northeast-2"
vpc_id         = "<VPC_ID>"
instance_ids = {
  monitoring = "<MONITORING_INSTANCE_ID>"
}
