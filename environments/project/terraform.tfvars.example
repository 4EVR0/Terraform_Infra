# Copy to local.auto.tfvars on a new checkout, then replace placeholders.
# If local.auto.tfvars.json already exists, edit that file instead.
# The monitoring import also requires monitoring_config, whose full object schema
# is defined in monitoring-variables.tf. Obtain reviewed values privately;
# do not derive desired settings dynamically from the live instance on every plan.
# The security group import additionally requires monitoring_security_group,
# defined in monitoring-security-group-variables.tf, including stable rule keys.
# The IAM import additionally requires monitoring_iam, defined in
# monitoring-iam-variables.tf. Keep the actual trust and permission policy JSON
# in an ignored local tfvars file rather than this public example.
# The monitoring S3 import additionally requires monitoring_s3, defined in
# monitoring-s3-variables.tf. Keep the globally unique bucket name in ignored
# local tfvars.
# The Airflow EC2 import additionally requires airflow_config, whose full object
# schema is defined in airflow-variables.tf. Obtain reviewed values privately.
# The Airflow security group import additionally requires airflow_security_group,
# defined in airflow-security-group-variables.tf, including stable rule keys.
# The Airflow IAM import additionally requires airflow_iam, defined in
# airflow-iam-variables.tf. Keep the actual trust policy and policy ARNs in an
# ignored local tfvars file.
# The GraphDB EC2 import additionally requires graphdb_config, whose full object
# schema is defined in graphdb-variables.tf. Keep all reviewed instance values in
# an ignored local tfvars file; never copy legacy user data into Terraform input.
# The GraphDB dependency import additionally requires graphdb_security_group and
# graphdb_iam. Keep existing rule IDs, policy ARNs, and policy documents in an
# ignored local tfvars file.
aws_account_id = "<AWS_ACCOUNT_ID>"
aws_region     = "ap-northeast-2"
vpc_id         = "<VPC_ID>"
instance_ids = {
  monitoring = "<MONITORING_INSTANCE_ID>"
  airflow    = "<AIRFLOW_INSTANCE_ID>"
  graphdb    = "<GRAPHDB_INSTANCE_ID>"
}
